# ====== Servidor ======
PORT=4000
NODE_ENV=development
# Desfase horario de la biblioteca respecto de UTC (Argentina = -3). Se usa para "hoy" y los vencimientos.
TZ_OFFSET_HORAS=-3
# Origen permitido por CORS ("*" = cualquiera; la app móvil no lo necesita pero no molesta)
CORS_ORIGIN=*

# ====== Base de datos MySQL EN LA NUBE (nunca local) ======
# Datos que te da tu proveedor (Aiven, Railway, TiDB Cloud, Clever Cloud, etc.)
DB_HOST=tu-host.proveedor.com
DB_PORT=3306
DB_USER=usuario
DB_PASSWORD=contraseña
DB_NAME=ceibo_libros
# La mayoría de los servicios en la nube exigen SSL:
DB_SSL=true
# Si el proveedor te da un certificado CA, poné la ruta al archivo (o pegalo en DB_SSL_CA con \n en vez de saltos de línea)
DB_SSL_CA_PATH=
DB_SSL_CA=
# Solo para pruebas si el proveedor no entrega CA (menos seguro): false
DB_SSL_REJECT_UNAUTHORIZED=true

# ====== JWT ======
# Generá secretos largos y distintos:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambiar-por-un-secreto-largo
JWT_ACCESS_EXP=15m
JWT_REFRESH_DIAS=30

# ====== Email (códigos de verificación, 2 pasos, recordatorios, pedidos a distribuidora) ======
# Si SMTP_HOST queda vacío, los emails NO se envían: se imprimen en la consola del servidor (modo desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ceibo Libros <no-reply@ceibolibros.com>"

# ====== Redes sociales (OAuth) ======
# Google: IDs de cliente de tu proyecto de Google Cloud (web, android), separados por coma. Se valida que el token sea de tu app.
GOOGLE_CLIENT_IDS=
# GitHub: OAuth App (el secret vive SOLO en el servidor)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Discord: Application ID
DISCORD_CLIENT_ID=

# ====== Reglas de la biblioteca ======
RECORDATORIO_DIAS=2
PRESTAMO_DIAS_DEFECTO=14
PRESTAMO_MAX_LIBROS=5
RESERVAS_MAX_ACTIVAS=3
# Hora (formato cron) en que corre la tarea diaria de recordatorios/bloqueos y su zona horaria
CRON_RECORDATORIOS=0 9 * * *
CRON_TZ=America/Argentina/Buenos_Aires

# ====== Disparador externo de la tarea diaria (opcional) ======
# Útil si tu hosting "duerme" el servidor: un cron externo (cron-job.org) puede hacer
#   POST https://TU-BACKEND/api/mantenimiento/recordatorios   con el header  x-cron-secret: <este valor>
CRON_SECRET=

# ====== Límite anti fuerza bruta ======
# Intentos de login/registro/códigos permitidos cada 15 min por IP (por defecto 20)
LIMITE_AUTH=20
# Peticiones por minuto permitidas por IP en el resto de la API (por defecto 600)
LIMITE_GENERAL=600

# Railway: en vez de DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME se puede pegar la dirección completa que da Railway
# (MYSQL_URL=mysql://usuario:clave@host:puerto/railway). Con Railway dejá DB_SSL=false.
# MYSQL_URL=

# Horarios de visita a la biblioteca (hora local; dias: 1=lunes ... 7=domingo)
VISITA_HORA_APERTURA=8
VISITA_HORA_CIERRE=18
VISITA_DIAS=1,2,3,4,5,6
VISITA_PASO_MIN=30
VISITA_GRACIA_HORAS=2

# Solo si publicás en Vercel: conexiones máximas por instancia (evita saturar la base)
DB_POOL_MAX=3
