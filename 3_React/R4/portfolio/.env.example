# Copiá este archivo como .env y completá tus datos

PORT=3000

# Datos de conexión de TiDB Cloud (botón "Connect" de tu cluster)
TIDB_HOST=gateway01.xxxx.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=xxxxxxxx.root
TIDB_PASSWORD=tu_contraseña
TIDB_DB_NAME=test
# Solo para una base MySQL local sin SSL:
# TIDB_SSL=false

# Texto largo al azar. Generalo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiame_por_un_texto_largo_al_azar
