    "@types/node": "^20.19.43",
    "@vercel/node": "^20.0.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
